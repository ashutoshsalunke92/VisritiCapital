# ── Iron Fly / ATM Iron Condor ──────────────────────────────────────────────
ENTRY_TIME=10:16
EXIT_TIME=14:59
PER_LEG_SL_PCT=0.25
STRATEGY_SL_PCT=0.25
STRATEGY_TP_PCT=0.25
LOT_SIZE=75
LOTS=1
STRIKE_STEP=50
OTM_WING_STRIKES=7
UNDERLYING=NIFTY
HEDGE_LEG_SL_PCT=
MIN_CREDIT_TO_WIDTH_PCT=0.0
IRONFLY_CAPITAL=250000

# NEW — monthly Iron Condor is now genuinely different from weekly (fix #6).
# Leave blank to default to 2x the weekly SL/TP (matches the PDF's 4%/2% ->
# 8%/4% ratio). Exit is this many days before that cycle's real monthly expiry.
MONTHLY_STRATEGY_SL_PCT=
MONTHLY_STRATEGY_TP_PCT=
IRON_CONDOR_MONTHLY_EXIT_DAYS_BEFORE_EXPIRY=14

# ── Hedged 25-Delta Strangle ─────────────────────────────────────────────
STRANGLE_UNDERLYING=NIFTY
STRANGLE_ENTRY_TIME=10:16
STRANGLE_EXIT_TIME=14:59
STRANGLE_TIMEFRAME=INTRADAY
STRANGLE_LOTS=1
STRANGLE_CAPITAL=250000
STRANGLE_SHORT_DELTA=25.0
STRANGLE_DELTA_TOLERANCE=3.0
STRANGLE_HEDGE_DELTA=5.0
STRANGLE_HEDGE_FALLBACK_PTS=350.0
RISK_FREE_RATE=0.065
ADJ_DELTA_BREACH=40.0
ADJ_MAX_PER_TRADE=2
ADJ_NO_ROLL_DTE=10
ADJ_MAX_DEBIT_PCT=0.005
STRANGLE_MIN_IVR_PCT=0.0

# NEW — fixes #1/#7 (performance + correctness). Previously the strangle
# fetched the ENTIRE option chain (100+ strikes) every 5 simulated minutes,
# which is what made it look "broken" (rate-limited / never finished).
STRANGLE_STRIKE_WINDOW=20
REPLAY_INTERVAL_MINS=5

# ── Trailing SL (fix #2) ────────────────────────────────────────────────
# STATIC (default) = unchanged fixed SL/TP behavior for BOTH strategies.
# TRAILING = once profit reaches TRAIL_ACTIVATE_PCT of the static TP, the
# fixed TP is replaced by a trailing stop that ratchets up behind the peak
# profit and exits once TRAIL_GIVEBACK_PCT of that peak is given back. The
# static SL always stays live underneath as a hard floor either way.
SL_MODE=STATIC
TRAIL_ACTIVATE_PCT=0.5
TRAIL_GIVEBACK_PCT=0.3

# ── Session defaults (fixes #3/#4/#5 — menu no longer prompts for these) ──
BACKTEST_WINDOW_DAYS=180
OUTPUT_DIR=output
FIXED_CAPITAL=250000

# ── Notifications / external APIs (optional) ───────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FINNHUB_API_KEY=
VIX_CSV_PATH=

# ── Exit Engine policy YAML paths (optional — defaults to config/ in project dir) ──
# Override only if you want to keep policy files elsewhere.
# EXIT_POLICY_IRONFLY_INTRADAY=config/iron_fly_exit_policy.yaml
